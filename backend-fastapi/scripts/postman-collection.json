      "name": "Search",
      "item": [
        {
          "name": "Search Songs",
          "request": {
            "method": "GET",
            "description": "Search songs with optional filters.\n\nTheme/classification are exact-match after lowercasing so case\nvariants collapse into a single bucket. Year range is bounded\nby ``year_from <= year_to``; the helper raises 400 if inverted.\n\nThe ``q`` parameter is also exposed as ``query`` so the existing\nVue dashboard (which sends ``?query=...``) keeps working\nwithout a frontend change.",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
