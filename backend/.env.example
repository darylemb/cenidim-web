# Backend env vars (documented; not committed values)
PORT=8080
DB_PATH=letras.db
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173,http://localhost:8000
JWT_SECRET=change-me-to-a-long-random-string

# Google sign-in (feature 004-interactive-themes-oauth)
# Create OAuth client at https://console.cloud.google.com/apis/credentials
# Redirect URL must match exactly: <FRONTEND_BASE_URL>/api/auth/google/callback is NOT used;
# the backend exposes /api/auth/google/callback and Google posts back there.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback
FRONTEND_BASE_URL=http://localhost:3000
